# 决策模型：TypeSafe Jev
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# 文本模型（TYPE_TEXT 字段值与 planner/supervisor 共用）：OpenAI 兼容
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-flash
TEXT_MODEL_REASONING=none

# 浏览器二进制目录：代码里自动指向工作区 .browsers，不必写在这里
# （要在命令行装浏览器，先 `. .\scripts\env.ps1` 导出同一个目录）

# 产物策略: debug=逐步截图 / ci=只留失败一张（与有无头解绑）
UI_AGENT_MODE=debug
# 有无头: 不设=按 mode 推（debug 可视化、ci 无头）；平台/服务器固定 true
# UI_AGENT_HEADLESS=true
UI_AGENT_VIEWPORT=1920x1080
UI_AGENT_CONF_MIN=0.55

# 监督模型（M2）：卡住时最多问几次；不设即用 config.py 的默认值
# UI_AGENT_SUPERVISOR=true
# SUPERVISOR_PER_STEP=2
# SUPERVISOR_PER_RUN=6

# 上传通道（M3）：input=给隐藏 input 注入文件 / drop=页内合成拖拽事件
# UI_AGENT_UPLOAD_MODE=input

# 原生对话框应答（M3）：dismiss=关掉（默认，不改变页面状态）/ accept=点确定
# UI_AGENT_DIALOG_POLICY=dismiss
