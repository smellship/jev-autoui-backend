# 平台后端配置（复制为 .env 后按需改；.env 已在 .gitignore）
# 本地开发默认 SQLite；生产改成 MySQL：mysql+pymysql://user:pwd@host:3306/ui_web
UI_WEB_DB_URL=sqlite:///./ui_web.db
UI_WEB_ARTIFACTS_DIR=artifacts
UI_WEB_SECRETS_DIR=secrets

# 内核：默认就是同一个 venv 里的控制台脚本（内核 = kernel/ 下的本地副本，见 README「整体部署」）
UI_WEB_KERNEL_CMD=ui-agent
# 只想跑平台、不碰内核时改用桩（Windows 示例）：
# UI_WEB_KERNEL_CMD="C:/path/ui_backend/.venv/Scripts/python.exe" "C:/path/ui_backend/scripts/fake_kernel.py"
UI_WEB_KERNEL_CWD=
UI_WEB_KERNEL_TIMEOUT_S=300
UI_WEB_KERNEL_RUN_TIMEOUT_S=1800

# 登录（生产必须改 JWT_SECRET 与管理员口令）
UI_WEB_JWT_SECRET=dev-only-change-me
UI_WEB_JWT_TTL_MIN=720
UI_WEB_ADMIN_ACCOUNT=admin
UI_WEB_ADMIN_PASSWORD=admin123
UI_WEB_ADMIN_NAME=管理员

# 并行调度（默认串行）：这里只是「全局并行上限 max」的初始值；
# 管理员在设置页「并行调度」里改的 max/k 落 secrets/_run_settings.local.yaml，优先级高于本项
UI_WEB_RUN_CONCURRENCY=1

# 保留策略（§13）
UI_WEB_RETENTION_ENABLED=true
UI_WEB_RETENTION_INTERVAL_H=24
UI_WEB_RETENTION_DAYS_SCREENSHOTS=14
UI_WEB_RETENTION_KEEP_DEBUG_RUNS=20
UI_WEB_RETENTION_DAYS_SNAPSHOTS=30
UI_WEB_RETENTION_KEEP_SNAPSHOT_RUNS=200
UI_WEB_RETENTION_DAYS_REPORT=30
UI_WEB_RETENTION_TOTAL_GB=10

# 前端来源（逗号分隔，默认全放开）
UI_WEB_CORS_ORIGINS=*
